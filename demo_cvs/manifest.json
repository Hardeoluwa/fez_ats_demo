   "title": "Dispatch Rider",
   "description": "Deliver parcels on time using a company motorcycle across Lagos. Strong route knowledge and navigation, a valid riding licence, safe riding, proof of delivery, cash handling, customer service, punctual and reliable, comfortable with a smartphone delivery app."
  },
  {
   "title": "Customer Support Executive",
   "description": "Handle customer enquiries and complaints by phone, email and chat. Track parcels, resolve delivery issues, escalate problems, keep accurate ticket records, communicate clearly and with empathy, work shifts, use CRM and helpdesk software, meet response time targets."
  },
  {
   "title": "Data Analyst",
   "description": "Analyse logistics and operations data with SQL, Python and Excel. Build dashboards in Power BI or Metabase, automate reporting, clean and validate data, present insights to managers, understand delivery performance, hubs, riders and customer metrics."
  },
  {
   "title": "Hub Operations Supervisor",
   "description": "Supervise daily hub operations: parcel sorting, inventory and dispatch scheduling, rider coordination, staff supervision, quality checks, damaged and returned parcels, safety compliance, performance reports, team leadership, achieving delivery targets."
  }
