
# HR login — replace these placeholders locally
HR_USERNAME=hr
HR_PASSWORD=replace-with-a-strong-password

# Email integration
ZOHO_EMAIL=your-fez-mailbox@example.com
ZOHO_APP_PASSWORD=your-zoho-app-password
ZOHO_IMAP_HOST=imap.zoho.eu
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465

# AI integration
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# Application settings
PASS_THRESHOLD=7
HR_SIGNATURE=HR Team, Fez Delivery Co.

# --- Branding: put the logo in assets/logo.svg (or .png/.jpg/.webp) and set the real Fez hex codes ---
BRAND_PRIMARY = "#45C734"   # Official Fez green
BRAND_ACCENT = "#00243D"    # Official Fez deep navy
BRAND_DARK = "#00243D"      # Official Fez deep navy
BRAND_BG = "#F7FAF6"        # Recommended UI background

BRAND_WHITE = "#FFFFFF"     # Official
BRAND_MUTED = "#64748B"     # Recommended UI text
BRAND_BORDER = "#E2E8E5"    # Recommended UI border